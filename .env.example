# Copie para .env (no Windows: copy .env.example .env), preencha e rode: php artisan key:generate

APP_NAME="OEE Alumbra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Endereço do portal (em produção, https://...)
# Em produção: APP_URL=https://www.alumbra.com.br/oee (subpasta do IIS; sem barra no final)
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Datas ficam em UTC no banco e aparecem nas telas neste fuso
FUSO_EXIBICAO=America/Sao_Paulo
# Dispositivo IoT sem sinal há mais que estes minutos aparece como "sem sinal"
IOT_MINUTOS_SEM_SINAL=5
# Hora em que começa o dia de produção na Timeline
TIMELINE_INICIO_DIA=06:00

# ============================== Microsoft Entra ID ==============================
# O Entra ID só autentica a entrada. Dados do registro de aplicativo (veja o README):
# ID do diretório (locatário) — use o GUID, não o domínio
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ID do aplicativo (cliente)
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Valor do segredo do cliente
ENTRA_CLIENT_SECRET=
# Deve estar cadastrado como URI de redirecionamento "Web" no registro do app
ENTRA_REDIRECT_URI="${APP_URL}/auth/callback"

# E-mails que NASCEM administradores no primeiro login (separados por vírgula). Todos os outros usuários são
# cadastrados no primeiro login SEM ACESSO; um administrador libera em Cadastros > Logins > Usuários.
PORTAL_ADMINS=marcato@alumbra.com.br

# ============================== Banco de dados ==============================
# Usuários, logins, cadastros e dados das máquinas ficam aqui.
# Depois de configurar: "php artisan banco:testar" confere a conexão e "php artisan migrate" cria as tabelas.
# No portal, administradores veem a conexão em uso no menu Banco.
#
# Para testar sem SQL Server, use DB_CONNECTION=sqlite e apague as linhas DB_* abaixo
# (cria database/database.sqlite).
DB_CONNECTION=sqlsrv
# Servidor: nome ou IP. Instância nomeada: SERVIDOR\INSTANCIA sem aspas (ex.: TERRA\SOLO) e DB_PORT vazio
# (o serviço SQL Browser informa a porta). Porta preenchida faz o driver ignorar o nome da instância.
DB_HOST=
DB_PORT=
DB_DATABASE=OEE_Alumbra
# Usuário e senha do SQL Server. Deixe os dois vazios para usar a autenticação do Windows
# (a conta que roda o portal precisa ter login no SQL Server).
DB_USERNAME=oee_app
DB_PASSWORD=
# Conexão criptografada (recomendado). TRUST_SERVER_CERTIFICATE=true quando o SQL Server usa o certificado
# autoassinado que ele mesmo gera (o normal em rede interna); false só com certificado de uma autoridade confiável.
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

# ============================== Sessão e cache ==============================
# Sessão expira após 120 minutos sem uso
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Produção (subpasta /oee, HTTPS): SESSION_PATH=/oee, SESSION_SECURE_COOKIE=true e SESSION_COOKIE=oee-alumbra-sessao
# (sem SESSION_PATH vale a subpasta do APP_URL). Também: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning.
SESSION_DOMAIN=null

# Um servidor só (IIS): "file" alivia o SQL Server (limites de requisição, travas, sinal do agendador a cada minuto).
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Atrás de proxy reverso/IIS com HTTPS: IPs dos proxies confiáveis (ou * se o portal só é acessível pelo proxy)
# TRUSTED_PROXIES=

# ============================== Pedidos de compra (tabela muro do Protheus) ==============================
# O portal grava os pedidos de compra nas tabelas nativas ZP1 (cabeçalho) e ZP2 (itens) do Protheus, criadas pelo
# compatibilizador U_OEEUPDPC (integracao-protheus/pedido-compra/); o job OEEPCJOB gera o pedido e devolve o status.
# COMPRAS_MURO_ALIAS=ZP1
# COMPRAS_MURO_ALIAS_ITENS=ZP2
# Por padrão usa o servidor, o banco e o usuário do Protheus; MURO_DB_* só se for diferente.
# MURO_DB_DATABASE=
# MURO_DB_USERNAME=
# MURO_DB_PASSWORD=
# COMPRAS_FILIAL=0101
# COMPRAS_ATUALIZAR_CRON="*/10 * * * *"

# ============================== Protheus (só leitura) ==============================
# Sincronização dos centros de custo (tabela CTT). Botão em Administração > Banco de dados ou
# "php artisan protheus:sincronizar". Por padrão usa o MESMO servidor e o MESMO usuário do portal (DB_*), no banco
# "Compras". Preencha PROTHEUS_DB_* só se o Protheus estiver em outro servidor ou com outro usuário.
PROTHEUS_DB_DATABASE=Compras
# PROTHEUS_DB_HOST=
# PROTHEUS_DB_PORT=
# PROTHEUS_DB_USERNAME=
# PROTHEUS_DB_PASSWORD=
# Tabelas no banco do Protheus: centros de custo (CTT) e máquinas / centros de trabalho (SHB)
PROTHEUS_TABELA_CTT=CTT
PROTHEUS_TABELA_SHB=SHB
# Produtos (SB1) e ordens de produção (SC2)
PROTHEUS_TABELA_SB1=SB1
PROTHEUS_TABELA_SC2=SC2
# Empenhos das OPs (SD4). Se no banco ela tiver outro nome (ex.: SD4010 ou dbo.SD4010), informe aqui.
PROTHEUS_TABELA_SD4=SD4
# Só OPs emitidas a partir desta data (AAAAMMDD), para não trazer anos de histórico. Vazio = todas.
PROTHEUS_SC2_DESDE=
# Linhas por lote na sincronização (lê e grava de tantas em tantas, para não estourar a memória do PHP)
PROTHEUS_SINCRONIZAR_LOTE=1000
# Sincronização automática (cron). Vazio = desligada. Ex.: "0 * * * *" = de hora em hora.
# Precisa do agendador rodando como serviço (README, "Sincronização automática com o Protheus").
PROTHEUS_SINCRONIZAR_CRON=

# ----- Pergunte para Alumbra (assistente de IA da página inicial, com a Claude) -----
# Chave da API da Anthropic (console.anthropic.com > API Keys). Vazio = o box avisa que não está configurado.
ANTHROPIC_API_KEY=
# Modelo e esforço (low | medium | high | xhigh | max). Mais esforço = respostas melhores, mais lentas e mais tokens.
ASSISTENTE_MODELO=claude-opus-5-5
ASSISTENTE_ESFORCO=medium
# Perguntas por usuário por dia (0 = sem limite) e segundos por chamada (abaixo do activityTimeout do IIS, padrão 70 s).
ASSISTENTE_LIMITE_DIARIO=60
ASSISTENTE_TIMEOUT=60

# Integrador MQTT: token da rota /api/iot/apontamentos/processar (o mesmo no config.toml do integrador, [oee] portal_token)
IOT_TOKEN=


<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Garante que /oee/ abra o index.php -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- Não herdar as regras do Default Web Site (Laravel PHP 7.4) -->
        <clear />

        <rule name="OEE Laravel" stopProcessing="true">
          <match url="^(.*)$" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <!-- SEM barra no início: relativo à aplicação /oee -->
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>

<handlers>
    <clear />

    <add name="PHP_83" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\OEE\php8.3\php-cgi.exe" resourceType="Either" requireAccess="Script" />

    <add name="StaticFile" path="*" verb="GET,HEAD" modules="StaticFileModule" resourceType="File" />
</handlers>

    <httpErrors errorMode="Detailed" />

  </system.webServer>
</configuration>
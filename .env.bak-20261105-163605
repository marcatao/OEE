ENTRA_TENANT_ID=acb39e2b-79fa-4e80-8302-3011ca0d98cb
# ID do aplicativo (cliente)
ENTRA_CLIENT_ID=d28b6b9d-afef-434c-b11f-361ccc5be669
# Valor do segredo do cliente
ENTRA_CLIENT_SECRET=uCP8Q~m0icWIdIsykXBo5C9W6gyb1O2xJiwEOcCD
# Deve estar cadastrado como URI de redirecionamento "Web" no registro do app

#include "totvs.ch"

/*/{Protheus.doc} OEEUPDPC
Compatibilizador (dicionário) das tabelas muro OEE Alumbra -> Protheus dos pedidos de compra:
  ZP1  OEE - Pedido de compra (cabeçalho)
  ZP2  OEE - Itens do pedido de compra
Grava SX2 (tabela), SX3 (campos) e SIX (índices) e cria a tabela física (X31UpdTable + DbSelectArea).
Pode rodar de novo: atualiza o que já existe (não apaga nada).

Como rodar (com ninguém usando as tabelas ZP1/ZP2):
  - SmartClient, programa inicial  U_OEEUPDPC  (usa a empresa/filial de EMPRESA_PADRAO/FILIAL_PADRAO abaixo); ou
  - Fórmulas / Executar, já logado na empresa:  U_OEEUPDPC()

Se o alias ZP1 ou ZP2 já for usado por outra customização, o programa PARA sem mexer em nada: troque ALIAS_CAB /
ALIAS_ITE abaixo, rode de novo e informe no .env do portal COMPRAS_MURO_ALIAS / COMPRAS_MURO_ALIAS_ITENS e no job
(parâmetros MV_XOEEPCC / MV_XOEEPCI = os aliases).
/*/

#define EMPRESA_PADRAO "01"
#define FILIAL_PADRAO  "01"
#define ALIAS_CAB      "ZP1"
#define ALIAS_ITE      "ZP2"
#define NOME_CAB       "OEE - PEDIDO DE COMPRA"
#define NOME_ITE       "OEE - ITENS DO PEDIDO COMPRA"

User Function OEEUPDPC(aParam)
    Local lPreparou := .F.
    Local cEmp      := EMPRESA_PADRAO
    Local cFil      := FILIAL_PADRAO
    Local cMsg      := ""

    If ValType(aParam) == "A" .And. Len(aParam) >= 2
        cEmp := aParam[1]
        cFil := aParam[2]
    EndIf
    If Select("SX2") == 0
        RpcSetType(3)
        RpcSetEnv(cEmp, cFil, , , "COM", "OEEUPDPC")
        lPreparou := .T.
    EndIf

    cMsg := Atualiza()
    UpdLog(cMsg)
    If !IsBlind()
        MsgInfo(cMsg, "OEEUPDPC")
    EndIf

    If lPreparou
        RpcClearEnv()
    EndIf
Return

Static Function Atualiza()
    Local cConflito := ""
    Local aTabelas  := {ALIAS_CAB, ALIAS_ITE}
    Local cTrace    := ""
    Local nI        := 0

    // Não sobrescreve um alias que já é de outra customização.
    cConflito := AliasDeOutro(ALIAS_CAB, NOME_CAB) + AliasDeOutro(ALIAS_ITE, NOME_ITE)
    If !Empty(cConflito)
        Return "Nada foi alterado. " + cConflito
    EndIf

    AtuSX2(ALIAS_CAB, NOME_CAB, ALIAS_CAB + "_FILIAL+" + ALIAS_CAB + "_IDPORT")
    AtuSX2(ALIAS_ITE, NOME_ITE, ALIAS_ITE + "_FILIAL+" + ALIAS_ITE + "_IDPORT+" + ALIAS_ITE + "_ITEM")
    AtuSX3Cab()
    AtuSX3Ite()
    AtuSIX(ALIAS_CAB, "1", ALIAS_CAB + "_FILIAL+" + ALIAS_CAB + "_IDPORT", "Nr. Portal")
    AtuSIX(ALIAS_CAB, "2", ALIAS_CAB + "_FILIAL+" + ALIAS_CAB + "_STATUS+" + ALIAS_CAB + "_IDPORT", "Status + Nr. Portal")
    AtuSIX(ALIAS_CAB, "3", ALIAS_CAB + "_FILIAL+" + ALIAS_CAB + "_NUMPED", "Pedido de compra")
    AtuSIX(ALIAS_ITE, "1", ALIAS_ITE + "_FILIAL+" + ALIAS_ITE + "_IDPORT+" + ALIAS_ITE + "_ITEM", "Nr. Portal + Item")

    // Cria/ajusta a tabela física e os índices pelo dicionário.
    __SetX31Mode(.F.)
    For nI := 1 To Len(aTabelas)
        If Select(aTabelas[nI]) > 0
            (aTabelas[nI])->(DbCloseArea())
        EndIf
        X31UpdTable(aTabelas[nI])
        If __GetX31Error()
            cTrace += aTabelas[nI] + ": " + __GetX31Trace() + CRLF
        EndIf
        DbSelectArea(aTabelas[nI])
    Next

    If !Empty(cTrace)
        Return "Dicionário gravado, mas houve erro ao criar a tabela física:" + CRLF + cTrace
    EndIf
Return "Tabelas " + RetSqlName(ALIAS_CAB) + " e " + RetSqlName(ALIAS_ITE) + " criadas/atualizadas no dicionário e no banco."

/** "" se o alias está livre ou já é nosso; senão o aviso. */
Static Function AliasDeOutro(cAlias, cNome)
    SX2->(DbSetOrder(1))
    If SX2->(DbSeek(cAlias)) .And. AllTrim(SX2->X2_NOME) <> cNome
        Return "O alias " + cAlias + " já existe (" + AllTrim(SX2->X2_NOME) + "). "
    EndIf
Return ""

// ---------------------------------------------------------------------------------------------------------------
// SX2 - tabela (compartilhada: a filial do pedido fica no campo _FILPED)
// ---------------------------------------------------------------------------------------------------------------
Static Function AtuSX2(cAlias, cNome, cUnico)
    Local cPath   := ""
    Local cSufixo := "010"
    Local lNovo   := .F.

    SX2->(DbSetOrder(1))
    If SX2->(DbSeek("SC7"))
        cPath   := SX2->X2_PATH
        cSufixo := SubStr(AllTrim(SX2->X2_ARQUIVO), 4)
    EndIf
    lNovo := !SX2->(DbSeek(cAlias))

    RecLock("SX2", lNovo)
    Grava("SX2", { ;
        {"X2_CHAVE", cAlias}, {"X2_PATH", cPath}, {"X2_ARQUIVO", cAlias + cSufixo}, ;
        {"X2_NOME", cNome}, {"X2_NOMESPA", cNome}, {"X2_NOMEENG", cNome}, ;
        {"X2_MODO", "C"}, {"X2_MODOUN", "C"}, {"X2_MODOEMP", "C"}, {"X2_DELET", 0}, {"X2_TTS", ""}, {"X2_ROTINA", ""}, ;
        {"X2_PYME", "S"}, {"X2_UNICO", cUnico}, {"X2_DISPLAY", ""}, {"X2_SYSOBJ", ""}, {"X2_USROBJ", ""}, ;
        {"X2_POSLGT", "1"}, {"X2_CLOB", "2"}, {"X2_AUTREC", "2"}, {"X2_MODULO", 2}})
    SX2->(MsUnlock())
Return

// ---------------------------------------------------------------------------------------------------------------
// SX3 - campos
// ---------------------------------------------------------------------------------------------------------------
Static Function AtuSX3Cab()
    Local a       := ALIAS_CAB
    Local nFilial := FWSizeFilial()
    Local nCC     := TamSX3("CTT_CUSTO")[1]

    Campo(a, "01", "FILIAL", "C", nFilial, 0, "Filial",       "Filial do sistema",            "@!", .T.)
    Campo(a, "02", "IDPORT", "C", 10, 0, "Nr. Portal",         "Nr. do pedido no portal OEE",  "@!")
    Campo(a, "03", "ORIGEM", "C", 30, 0, "Origem",             "SM ou OS de origem no portal", "@!")
    Campo(a, "04", "FILPED", "C", nFilial, 0, "Filial Ped.",   "Filial do pedido (vazio=job)", "@!")
    Campo(a, "05", "CCORIG", "C", nCC, 0, "CC Origem",         "Centro de custo de origem",    "@!")
    Campo(a, "06", "CCDEST", "C", nCC, 0, "CC Destino",        "Centro de custo de destino",   "@!")
    Campo(a, "07", "FORNEC", "C", TamSX3("A2_COD")[1], 0, "Fornecedor", "Fornecedor (vazio=MV_XOEEFOR)", "@!")
    Campo(a, "08", "LOJA",   "C", TamSX3("A2_LOJA")[1], 0, "Loja",      "Loja (vazio=MV_XOEELOJ)",       "@!")
    Campo(a, "09", "COND",   "C", TamSX3("E4_CODIGO")[1], 0, "Cond.Pagto", "Cond. pagto (vazio=MV_XOEECND)", "@!")
    Campo(a, "10", "SOLIC",  "C", 60, 0, "Solicitante",        "Quem gerou no portal",         "")
    Campo(a, "11", "OBS",    "C", 250, 0, "Observacao",        "Observacao do pedido",         "")
    Campo(a, "12", "STATUS", "C", 20, 0, "Status",             "Situacao da integracao",       "@!")
    Campo(a, "13", "MSG",    "C", 250, 0, "Mensagem",          "Erro ou aviso do Protheus",    "")
    Campo(a, "14", "NUMPED", "C", TamSX3("C7_NUM")[1], 0, "Pedido",     "Numero do pedido (C7_NUM)",     "@!")
    Campo(a, "15", "DTINT",  "D", 8, 0, "Dt.Integr.",          "Data da integracao",           "")
    Campo(a, "16", "HRINT",  "C", 8, 0, "Hr.Integr.",          "Hora da integracao",           "99:99:99")
    Campo(a, "17", "APROV",  "C", 60, 0, "Aprovador",          "Quem aprovou o pedido",        "")
    Campo(a, "18", "DTAPRO", "D", 8, 0, "Dt.Aprov.",           "Data da aprovacao",            "")
    Campo(a, "19", "HRAPRO", "C", 8, 0, "Hr.Aprov.",           "Hora da aprovacao",            "99:99:99")
    Campo(a, "20", "DTCONC", "D", 8, 0, "Dt.Conclus.",         "Data da conclusao",            "")
    Campo(a, "21", "HRCONC", "C", 8, 0, "Hr.Conclus.",         "Hora da conclusao",            "99:99:99")
    Campo(a, "22", "VALOR",  "N", 16, 2, "Valor",              "Valor do pedido",              "@E 9,999,999,999,999.99")
    Campo(a, "23", "TENTAT", "N", 3, 0, "Tentativas",          "Tentativas de geracao",        "999")
    Campo(a, "24", "DTCRIA", "D", 8, 0, "Dt.Criacao",          "Data em que o portal gravou",  "")
    Campo(a, "25", "HRCRIA", "C", 8, 0, "Hr.Criacao",          "Hora em que o portal gravou",  "99:99:99")
    Campo(a, "26", "DTATU",  "D", 8, 0, "Dt.Atualiz.",         "Data da ultima alteracao",     "")
    Campo(a, "27", "HRATU",  "C", 8, 0, "Hr.Atualiz.",         "Hora da ultima alteracao",     "99:99:99")
Return

Static Function AtuSX3Ite()
    Local a := ALIAS_ITE

    Campo(a, "01", "FILIAL", "C", FWSizeFilial(), 0, "Filial", "Filial do sistema",            "@!", .T.)
    Campo(a, "02", "IDPORT", "C", 10, 0, "Nr. Portal",         "Nr. do pedido no portal OEE",  "@!")
    Campo(a, "03", "ITEM",   "C", 4, 0, "Item",                "Item do pedido",               "@!")
    Campo(a, "04", "IDITEM", "C", 10, 0, "Id Item",            "Nr. do item no portal OEE",    "@!")
    Campo(a, "05", "PROD",   "C", TamSX3("B1_COD")[1], 0, "Produto", "Codigo do produto",      "@!")
    Campo(a, "06", "DESC",   "C", 60, 0, "Descricao",          "Descricao do produto",         "")
    Campo(a, "07", "UM",     "C", TamSX3("B1_UM")[1], 0, "Unidade", "Unidade de medida",       "@!")
    Campo(a, "08", "QUANT",  "N", 14, 4, "Quantidade",         "Quantidade pedida",            "@E 999,999,999.9999")
    Campo(a, "09", "PRECO",  "N", 16, 4, "Preco",              "Preco (0=B1_UPRC/B2_CM1)",     "@E 99,999,999,999.9999")
    Campo(a, "10", "OBS",    "C", 100, 0, "Observacao",        "Observacao do item",           "")
    Campo(a, "11", "C7ITEM", "C", 4, 0, "Item Pedido",         "Item gerado (C7_ITEM)",        "@!")
    Campo(a, "12", "VUNIT",  "N", 16, 4, "Vlr.Unit.",          "Valor unitario (C7_PRECO)",    "@E 99,999,999,999.9999")
    Campo(a, "13", "VTOTAL", "N", 16, 2, "Vlr.Total",          "Valor total (C7_TOTAL)",       "@E 9,999,999,999,999.99")
    Campo(a, "14", "QTDENT", "N", 14, 4, "Qtd.Entreg.",        "Quantidade entregue (C7_QUJE)", "@E 999,999,999.9999")
Return

/** Grava (ou atualiza) um campo no SX3. lFilial = campo de filial (não usado nas telas, grupo 033). */
Static Function Campo(cAlias, cOrdem, cNome, cTipo, nTam, nDec, cTitulo, cDescr, cPicture, lFilial)
    Local cCampo  := PadR(cAlias + "_" + cNome, 10)
    Local lNovo   := .F.
    Local cUsado  := Replicate(Chr(128), 14) + Chr(160)   // usado em todos os módulos
    Local cReserv := Chr(254) + Chr(192)

    Default lFilial := .F.
    If lFilial
        cUsado  := Replicate(Chr(128), 15)                 // filial: não aparece nas telas
        cReserv := Chr(1) + Chr(0)
    EndIf

    SX3->(DbSetOrder(2))
    lNovo := !SX3->(DbSeek(cCampo))
    RecLock("SX3", lNovo)
    Grava("SX3", { ;
        {"X3_ARQUIVO", cAlias}, {"X3_ORDEM", cOrdem}, {"X3_CAMPO", cCampo}, {"X3_TIPO", cTipo}, ;
        {"X3_TAMANHO", nTam}, {"X3_DECIMAL", nDec}, ;
        {"X3_TITULO", cTitulo}, {"X3_TITSPA", cTitulo}, {"X3_TITENG", cTitulo}, ;
        {"X3_DESCRIC", cDescr}, {"X3_DESCSPA", cDescr}, {"X3_DESCENG", cDescr}, ;
        {"X3_PICTURE", cPicture}, {"X3_VALID", ""}, {"X3_USADO", cUsado}, {"X3_RELACAO", ""}, {"X3_F3", ""}, ;
        {"X3_NIVEL", 1}, {"X3_RESERV", cReserv}, {"X3_CHECK", ""}, {"X3_TRIGGER", ""}, {"X3_PROPRI", "U"}, ;
        {"X3_BROWSE", IIf(lFilial, "N", "S")}, {"X3_VISUAL", "V"}, {"X3_CONTEXT", "R"}, {"X3_OBRIGAT", ""}, ;
        {"X3_VLDUSER", ""}, {"X3_CBOX", ""}, {"X3_PICTVAR", ""}, {"X3_WHEN", ""}, {"X3_INIBRW", ""}, ;
        {"X3_GRPSXG", IIf(lFilial, "033", "")}, {"X3_FOLDER", ""}, {"X3_PYME", "S"}, {"X3_ORTOGRA", "N"}, {"X3_IDXFLD", "N"}})
    SX3->(MsUnlock())
Return

// ---------------------------------------------------------------------------------------------------------------
// SIX - índices
// ---------------------------------------------------------------------------------------------------------------
Static Function AtuSIX(cAlias, cOrdem, cChave, cDescr)
    Local lNovo := .F.

    SIX->(DbSetOrder(1))
    lNovo := !SIX->(DbSeek(cAlias + cOrdem))
    RecLock("SIX", lNovo)
    Grava("SIX", { ;
        {"INDICE", cAlias}, {"ORDEM", cOrdem}, {"CHAVE", cChave}, ;
        {"DESCRICAO", cDescr}, {"DESCSPA", cDescr}, {"DESCENG", cDescr}, ;
        {"PROPRI", "U"}, {"F3", ""}, {"NICKNAME", ""}, {"SHOWPESQ", "S"}})
    SIX->(MsUnlock())
Return

/** Grava só os campos que existem no dicionário desta versão (a estrutura das SX muda entre releases). */
Static Function Grava(cTabela, aCampos)
    Local nI   := 0
    Local nPos := 0

    For nI := 1 To Len(aCampos)
        nPos := (cTabela)->(FieldPos(aCampos[nI][1]))
        If nPos > 0
            (cTabela)->(FieldPut(nPos, aCampos[nI][2]))
        EndIf
    Next
Return

Static Function UpdLog(cTexto)
    FWLogMsg("INFO", , "OEEUPDPC", "OEEUPDPC", , , "[OEEUPDPC] " + cTexto)
Return

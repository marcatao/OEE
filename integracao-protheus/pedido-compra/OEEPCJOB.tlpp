#include "totvs.ch"
#include "topconn.ch"

/*/{Protheus.doc} OEEPCJOB
OEE Alumbra x Protheus: pedidos de compra pelas tabelas muro NATIVAS ZP1 (cabeçalho) e ZP2 (itens), criadas pelo
compatibilizador U_OEEUPDPC. O portal grava as linhas; este job só lê e atualiza (UPDATE condicionado ao status, para
não brigar com o cancelamento feito no portal). Ligação entre ZP1 e ZP2: _IDPORT (nº do pedido no portal).

Roda no Schedule (ou à mão: U_OEEPCJOB({"01", "0101"})). Cada execução:
  1. Destrava pedidos parados em PROCESSANDO há mais de 30 minutos (queda no meio da geração).
  2. Gera os pedidos com ZP1_STATUS = 'AGUARDANDO_PROTHEUS' (MATA120 por ExecAuto) e devolve o número:
     ZP1_STATUS = 'AGUARDANDO_APROVACAO' (ou 'APROVADO' se o pedido não cair em alçada) ou 'ERRO' com a mensagem.
  3. Confere os pedidos integrados (AGUARDANDO_APROVACAO e APROVADO) na SC7/SCR/SD1: aprovação (quem e quando),
     reprovação, conclusão (tudo entregue ou eliminado por resíduo) e os valores de cada item.

Parâmetros (SX6, todos opcionais; crie no Configurador como caractere):
  MV_XOEEFOR  fornecedor padrão (quando a muro não informa)       ex.: 000001
  MV_XOEELOJ  loja padrão                                          ex.: 01
  MV_XOEECND  condição de pagamento padrão                         ex.: 001
  MV_XOEECCO  campo da SC7 para o centro de custo de ORIGEM        ex.: C7_XCCORI (vazio = não grava)
  MV_XOEEPCC  alias da tabela muro do cabeçalho                    padrão: ZP1
  MV_XOEEPCI  alias da tabela muro dos itens                       padrão: ZP2

O centro de custo de DESTINO vai no C7_CC. O C7_OBS começa com "OEE#<nº do portal>": é assim que o job reconhece
um pedido já gerado se cair no meio da gravação.
/*/
User Function OEEPCJOB(aParam)
    Local lPreparou := .F.
    Local cEmp      := "01"
    Local cFil      := "01"

    If ValType(aParam) == "A" .And. Len(aParam) >= 2
        cEmp := aParam[1]
        cFil := aParam[2]
    EndIf

    If Select("SX2") == 0
        RpcSetType(3)
        RpcSetEnv(cEmp, cFil, , , "COM", "OEEPCJOB")
        lPreparou := .T.
    EndIf

    If LockByName("OEEPCJOB", .T., .F.)
        OeeLog("início")
        RecuperaTravados()
        GeraPendentes()
        AtualizaStatus()
        OeeLog("fim")
        UnLockByName("OEEPCJOB", .T., .F.)
    Else
        OeeLog("já está rodando em outra thread; nada a fazer agora.")
    EndIf

    If lPreparou
        RpcClearEnv()
    EndIf
Return

/*/{Protheus.doc} SchedDef
Definição para o Schedule novo (SIGACFG > Schedule): sem pergunta; empresa/filial vêm do agendamento.
/*/
Static Function SchedDef()
Return {"P", "PARAMDEF", "", {}, ""}

// ---------------------------------------------------------------------------------------------------------------
// 1. Pedidos que ficaram em PROCESSANDO há mais de 30 minutos (o job caiu no meio): se o pedido existe na SC7, é
//    dado como integrado; se não existe, volta para a fila.
// ---------------------------------------------------------------------------------------------------------------
Static Function RecuperaTravados()
    Local cAlias := Consulta("SELECT " + C("IDPORT") + " AS IDPORT FROM " + TabCab() + " WHERE " + C("STATUS") + " = 'PROCESSANDO'" + ;
        " AND " + C("DTATU") + " + ' ' + " + C("HRATU") + " < " + Q(Limite(30)) + " AND D_E_L_E_T_ = ' '")
    Local aIds   := {}
    Local nI     := 0
    Local cNum   := ""

    While !(cAlias)->(Eof())
        AAdd(aIds, AllTrim((cAlias)->IDPORT))
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

    For nI := 1 To Len(aIds)
        cNum := PedidoDaMuro(aIds[nI])
        If Empty(cNum)
            Exec("UPDATE " + TabCab() + " SET " + C("STATUS") + " = 'AGUARDANDO_PROTHEUS', " + Agora("ATU") + OndeCab(aIds[nI]) + " AND " + C("STATUS") + " = 'PROCESSANDO'")
        Else
            Exec("UPDATE " + TabCab() + " SET " + C("STATUS") + " = 'AGUARDANDO_APROVACAO', " + C("NUMPED") + " = " + Q(cNum) + ", " + ;
                Agora("INT") + ", " + Agora("ATU") + OndeCab(aIds[nI]))
            Exec("UPDATE " + TabIte() + " SET " + I("C7ITEM") + " = " + I("ITEM") + OndeIte(aIds[nI]))
        EndIf
    Next
Return

/** Número do pedido gerado para o nº do portal (procura o "OEE#<nº> " no C7_OBS), ou "" se não existe. */
Static Function PedidoDaMuro(cId)
    Local cNum   := ""
    Local cAlias := Consulta("SELECT TOP 1 C7_NUM FROM " + RetSqlName("SC7") + " WHERE C7_OBS LIKE " + Q(Marca(cId) + "%") + " AND D_E_L_E_T_ = ' '")

    If !(cAlias)->(Eof())
        cNum := AllTrim((cAlias)->C7_NUM)
    EndIf
    (cAlias)->(DbCloseArea())
Return cNum

// ---------------------------------------------------------------------------------------------------------------
// 2. Geração dos pedidos que o portal mandou
// ---------------------------------------------------------------------------------------------------------------
Static Function GeraPendentes()
    Local cAlias := Consulta("SELECT TOP 50 " + C("IDPORT") + " AS IDPORT FROM " + TabCab() + " WHERE " + C("STATUS") + " = 'AGUARDANDO_PROTHEUS'" + ;
        " AND D_E_L_E_T_ = ' ' ORDER BY " + C("IDPORT"))
    Local aIds   := {}
    Local nI     := 0

    While !(cAlias)->(Eof())
        AAdd(aIds, AllTrim((cAlias)->IDPORT))
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

    For nI := 1 To Len(aIds)
        // Reserva o pedido (só se ainda estiver na fila: o portal pode ter cancelado agora).
        Exec("UPDATE " + TabCab() + " SET " + C("STATUS") + " = 'PROCESSANDO', " + C("TENTAT") + " = " + C("TENTAT") + " + 1, " + Agora("ATU") + ;
            OndeCab(aIds[nI]) + " AND " + C("STATUS") + " = 'AGUARDANDO_PROTHEUS'")
        If StatusMuro(aIds[nI]) == "PROCESSANDO"
            GeraPedido(aIds[nI])
        EndIf
    Next
Return

Static Function GeraPedido(cId)
    Local cAlias    := ""
    Local cFilBkp   := cFilAnt
    Local cFilPed   := ""
    Local cFor      := ""
    Local cLoja     := ""
    Local cCond     := ""
    Local cCCOrig   := ""
    Local cCCDest   := ""
    Local cSolic    := ""
    Local cObsCab   := ""
    Local cCampoOri := AllTrim(SuperGetMV("MV_XOEECCO", .F., ""))
    Local aCab      := {}
    Local aItens    := {}
    Local aLinha    := {}
    Local aItMuro   := {}
    Local cErro     := ""
    Local cNum      := ""
    Local cProd     := ""
    Local nPreco    := 0
    Local nI        := 0
    Local bErroAnt  := Nil
    Local oErro     := Nil

    Private lMsErroAuto    := .F.
    Private lMsHelpAuto    := .T.
    Private lAutoErrNoFile := .T.

    cAlias := Consulta("SELECT " + C("FILPED") + " AS FILPED, " + C("CCORIG") + " AS CCORIG, " + C("CCDEST") + " AS CCDEST, " + ;
        C("FORNEC") + " AS FORNEC, " + C("LOJA") + " AS LOJA, " + C("COND") + " AS COND, " + C("SOLIC") + " AS SOLIC, " + C("OBS") + " AS OBS" + ;
        " FROM " + TabCab() + OndeCab(cId))
    cFilPed := AllTrim((cAlias)->FILPED)
    cCCOrig := AllTrim((cAlias)->CCORIG)
    cCCDest := AllTrim((cAlias)->CCDEST)
    cFor    := AllTrim((cAlias)->FORNEC)
    cLoja   := AllTrim((cAlias)->LOJA)
    cCond   := AllTrim((cAlias)->COND)
    cSolic  := AllTrim((cAlias)->SOLIC)
    cObsCab := AllTrim((cAlias)->OBS)
    (cAlias)->(DbCloseArea())

    cAlias := Consulta("SELECT " + I("ITEM") + " AS ITEM, " + I("PROD") + " AS PROD, " + I("QUANT") + " AS QUANT, " + I("PRECO") + " AS PRECO, " + ;
        I("OBS") + " AS OBS FROM " + TabIte() + OndeIte(cId) + " ORDER BY " + I("ITEM"))
    While !(cAlias)->(Eof())
        AAdd(aItMuro, {AllTrim((cAlias)->ITEM), AllTrim((cAlias)->PROD), (cAlias)->QUANT, (cAlias)->PRECO, AllTrim((cAlias)->OBS)})
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

    If Empty(cFor)
        cFor := AllTrim(SuperGetMV("MV_XOEEFOR", .F., ""))
    EndIf
    If Empty(cLoja)
        cLoja := AllTrim(SuperGetMV("MV_XOEELOJ", .F., "01"))
    EndIf
    If Empty(cCond)
        cCond := AllTrim(SuperGetMV("MV_XOEECND", .F., ""))
    EndIf

    bErroAnt := ErrorBlock({|e| oErro := e, Break(e)})
    Begin Sequence
        // Filial do pedido (vazio = a do job).
        If !Empty(cFilPed) .And. AllTrim(cFilAnt) <> cFilPed
            cFilAnt := PadR(cFilPed, Len(cFilAnt))
            SM0->(DbSeek(cEmpAnt + cFilAnt))
        EndIf

        If Len(aItMuro) == 0
            cErro := "Pedido sem itens na tabela muro (" + TabIte() + ")."
            Break
        EndIf
        If Empty(cFor) .Or. Empty(cCond)
            cErro := "Fornecedor ou condição de pagamento não informados (preencha os parâmetros MV_XOEEFOR, MV_XOEELOJ e MV_XOEECND)."
            Break
        EndIf

        SB1->(DbSetOrder(1))
        SB2->(DbSetOrder(1))
        For nI := 1 To Len(aItMuro)
            cProd := PadR(aItMuro[nI][2], TamSX3("B1_COD")[1])
            If !SB1->(DbSeek(xFilial("SB1") + cProd))
                cErro := "Item " + aItMuro[nI][1] + ": produto " + AllTrim(cProd) + " não encontrado na SB1."
                Break
            EndIf
            // Preço: o da muro; senão o último preço de compra (B1_UPRC); senão o custo médio do armazém padrão (B2_CM1).
            nPreco := aItMuro[nI][4]
            If nPreco <= 0
                nPreco := SB1->B1_UPRC
            EndIf
            If nPreco <= 0 .And. SB2->(DbSeek(xFilial("SB2") + SB1->B1_COD + SB1->B1_LOCPAD))
                nPreco := SB2->B2_CM1
            EndIf
            If nPreco <= 0
                cErro := "Item " + aItMuro[nI][1] + ": produto " + AllTrim(cProd) + " sem preço (sem B1_UPRC e sem custo médio)."
                Break
            EndIf
            nPreco := Round(nPreco, TamSX3("C7_PRECO")[2])

            aLinha := {}
            AAdd(aLinha, {"C7_ITEM",    PadL(aItMuro[nI][1], TamSX3("C7_ITEM")[1], "0"), Nil})
            AAdd(aLinha, {"C7_PRODUTO", SB1->B1_COD, Nil})
            AAdd(aLinha, {"C7_QUANT",   aItMuro[nI][3], Nil})
            AAdd(aLinha, {"C7_PRECO",   nPreco, Nil})
            AAdd(aLinha, {"C7_TOTAL",   Round(aItMuro[nI][3] * nPreco, 2), Nil})
            AAdd(aLinha, {"C7_CC",      PadR(cCCDest, TamSX3("C7_CC")[1]), Nil})
            AAdd(aLinha, {"C7_OBS",     Left(Marca(cId) + AllTrim(aItMuro[nI][5] + " " + cObsCab), TamSX3("C7_OBS")[1]), Nil})
            If !Empty(cCampoOri) .And. SC7->(FieldPos(cCampoOri)) > 0
                AAdd(aLinha, {cCampoOri, PadR(cCCOrig, TamSX3(cCampoOri)[1]), Nil})
            EndIf
            AAdd(aItens, aLinha)
        Next

        // Número do pedido (pula os que já existirem).
        SC7->(DbSetOrder(1))
        cNum := GetSXENum("SC7", "C7_NUM")
        While SC7->(DbSeek(xFilial("SC7") + cNum))
            ConfirmSX8()
            cNum := GetSXENum("SC7", "C7_NUM")
        EndDo

        AAdd(aCab, {"C7_NUM",     cNum, Nil})
        AAdd(aCab, {"C7_EMISSAO", dDataBase, Nil})
        AAdd(aCab, {"C7_FORNECE", PadR(cFor, TamSX3("C7_FORNECE")[1]), Nil})
        AAdd(aCab, {"C7_LOJA",    PadR(cLoja, TamSX3("C7_LOJA")[1]), Nil})
        AAdd(aCab, {"C7_COND",    PadR(cCond, TamSX3("C7_COND")[1]), Nil})
        AAdd(aCab, {"C7_CONTATO", Left(cSolic, TamSX3("C7_CONTATO")[1]), Nil})
        AAdd(aCab, {"C7_FILENT",  cFilAnt, Nil})

        lMsErroAuto := .F.
        MSExecAuto({|a, b, c, d, e| MATA120(a, b, c, d, e)}, 1, aCab, aItens, 3, .F.)

        If lMsErroAuto
            RollBackSX8()
            cErro := TextoErroAuto()
            Break
        EndIf
        ConfirmSX8()
    End Sequence
    ErrorBlock(bErroAnt)

    If oErro <> Nil
        cErro := "Erro no Protheus: " + oErro:Description
    EndIf

    cFilAnt := cFilBkp
    SM0->(DbSeek(cEmpAnt + cFilAnt))

    If !Empty(cErro)
        OeeLog("pedido do portal " + cId + ": " + cErro)
        Exec("UPDATE " + TabCab() + " SET " + C("STATUS") + " = 'ERRO', " + C("MSG") + " = " + Q(Left(StrTran(cErro, CRLF, " | "), 250)) + ", " + ;
            Agora("ATU") + OndeCab(cId))
        Return
    EndIf

    // Gerado: número e a situação da alçada (C7_CONAPRO = 'B' bloqueado = aguardando aprovação).
    OeeLog("pedido do portal " + cId + " gerado: " + cNum)
    Exec("UPDATE " + TabCab() + " SET " + C("STATUS") + " = 'AGUARDANDO_APROVACAO', " + C("NUMPED") + " = " + Q(cNum) + ", " + ;
        C("FILPED") + " = " + Q(IIf(Empty(cFilPed), cFilAnt, cFilPed)) + ", " + C("MSG") + " = ' ', " + Agora("INT") + ", " + Agora("ATU") + OndeCab(cId))
    Exec("UPDATE " + TabIte() + " SET " + I("C7ITEM") + " = " + I("ITEM") + OndeIte(cId))
    ConfereStatus(cId, IIf(Empty(cFilPed), cFilAnt, cFilPed), cNum)
Return

/** Texto do erro do ExecAuto (log de tela do MATA120). */
Static Function TextoErroAuto()
    Local aLog   := GetAutoGRLog()
    Local cTexto := ""
    Local nI     := 0

    For nI := 1 To Len(aLog)
        cTexto += AllTrim(aLog[nI]) + CRLF
    Next
    If Empty(cTexto)
        cTexto := "O MATA120 recusou o pedido (sem mensagem)."
    EndIf
Return cTexto

// ---------------------------------------------------------------------------------------------------------------
// 3. Situação dos pedidos já integrados
// ---------------------------------------------------------------------------------------------------------------
Static Function AtualizaStatus()
    Local cAlias := Consulta("SELECT " + C("IDPORT") + " AS IDPORT, " + C("FILPED") + " AS FILPED, " + C("NUMPED") + " AS NUMPED FROM " + TabCab() + ;
        " WHERE " + C("STATUS") + " IN ('AGUARDANDO_APROVACAO', 'APROVADO') AND " + C("NUMPED") + " <> ' ' AND D_E_L_E_T_ = ' ' ORDER BY " + C("IDPORT"))
    Local aPed   := {}
    Local nI     := 0

    While !(cAlias)->(Eof())
        AAdd(aPed, {AllTrim((cAlias)->IDPORT), AllTrim((cAlias)->FILPED), AllTrim((cAlias)->NUMPED)})
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

    For nI := 1 To Len(aPed)
        ConfereStatus(aPed[nI][1], IIf(Empty(aPed[nI][2]), cFilAnt, aPed[nI][2]), aPed[nI][3])
    Next
Return

Static Function ConfereStatus(cId, cFilPed, cNum)
    Local cFilSC7    := xFilial("SC7", PadR(cFilPed, Len(cFilAnt)))
    Local cAlias     := ""
    Local nLinhas    := 0
    Local lReprovado := .F.
    Local lBloqueado := .F.
    Local lConcluido := .T.
    Local nTotal     := 0
    Local nEntregue  := 0
    Local cStatus    := ""
    Local cSet       := ""
    Local aAprov     := {}
    Local aConc      := {}

    cAlias := Consulta("SELECT C7_ITEM, C7_QUANT, C7_QUJE, C7_PRECO, C7_TOTAL, C7_CONAPRO, C7_RESIDUO, C7_ENCER FROM " + RetSqlName("SC7") + ;
        " WHERE C7_FILIAL = " + Q(cFilSC7) + " AND C7_NUM = " + Q(cNum) + " AND D_E_L_E_T_ = ' '")
    While !(cAlias)->(Eof())
        nLinhas++
        lReprovado := lReprovado .Or. (cAlias)->C7_CONAPRO == "R"
        lBloqueado := lBloqueado .Or. (cAlias)->C7_CONAPRO == "B"
        lConcluido := lConcluido .And. ((cAlias)->C7_QUJE >= (cAlias)->C7_QUANT .Or. (cAlias)->C7_RESIDUO == "S" .Or. (cAlias)->C7_ENCER == "E")
        nTotal     += (cAlias)->C7_TOTAL
        nEntregue  += Round((cAlias)->C7_QUJE * (cAlias)->C7_PRECO, 2)
        Exec("UPDATE " + TabIte() + " SET " + I("VUNIT") + " = " + Num((cAlias)->C7_PRECO) + ", " + I("VTOTAL") + " = " + Num((cAlias)->C7_TOTAL) + ;
            ", " + I("QTDENT") + " = " + Num((cAlias)->C7_QUJE) + OndeIte(cId) + " AND " + I("C7ITEM") + " = " + Q((cAlias)->C7_ITEM))
        (cAlias)->(DbSkip())
    EndDo
    (cAlias)->(DbCloseArea())

    If nLinhas == 0
        Exec("UPDATE " + TabCab() + " SET " + C("STATUS") + " = 'CANCELADO', " + C("MSG") + " = " + Q("Pedido " + cNum + " excluído no Protheus.") + ", " + ;
            Agora("ATU") + OndeCab(cId))
        Return
    EndIf

    Do Case
    Case lReprovado
        cStatus := "REPROVADO"
    Case lBloqueado
        cStatus := "AGUARDANDO_APROVACAO"
    Case lConcluido
        cStatus := "CONCLUIDO"
    Otherwise
        cStatus := "APROVADO"
    EndCase

    // Concluído: o valor passa a ser o entregue (quantidade recebida x preço); antes, o total do pedido.
    cSet := C("STATUS") + " = " + Q(cStatus) + ", " + C("VALOR") + " = " + Num(IIf(cStatus == "CONCLUIDO", nEntregue, nTotal)) + ", " + Agora("ATU")
    If cStatus $ "APROVADO|CONCLUIDO"
        // Grava aprovador e data só uma vez (campos ainda em branco).
        aAprov := Aprovacao(cFilPed, cNum)
        cSet += ", " + SeVazio(C("APROV"), aAprov[1]) + ", " + SeVazio(C("DTAPRO"), aAprov[2]) + ", " + SeVazio(C("HRAPRO"), aAprov[3])
    EndIf
    If cStatus == "CONCLUIDO"
        aConc := Conclusao(cFilPed, cNum)
        cSet += ", " + SeVazio(C("DTCONC"), aConc[1]) + ", " + SeVazio(C("HRCONC"), aConc[2])
    EndIf
    Exec("UPDATE " + TabCab() + " SET " + cSet + OndeCab(cId))
Return

/** Quem aprovou e quando (SCR: último nível liberado do PC). Sem alçada: "Liberado sem alçada", agora. */
Static Function Aprovacao(cFilPed, cNum)
    Local cAlias := Consulta("SELECT TOP 1 CR_USERLIB, CR_DATALIB FROM " + RetSqlName("SCR") + ;
        " WHERE CR_FILIAL = " + Q(xFilial("SCR", PadR(cFilPed, Len(cFilAnt)))) + " AND RTRIM(CR_NUM) = " + Q(cNum) + ;
        " AND CR_TIPO IN ('PC', 'IP') AND CR_STATUS IN ('03', '05') AND D_E_L_E_T_ = ' ' ORDER BY CR_DATALIB DESC, R_E_C_N_O_ DESC")
    Local cNome  := "Liberado sem alçada"
    Local cData  := DToS(Date())
    Local cHora  := Time()

    If !(cAlias)->(Eof())
        If !Empty((cAlias)->CR_USERLIB)
            cNome := AllTrim(UsrFullName((cAlias)->CR_USERLIB))
        EndIf
        // A SCR guarda só a data da liberação: se não foi hoje, a hora fica em branco.
        If !Empty((cAlias)->CR_DATALIB) .And. AllTrim((cAlias)->CR_DATALIB) <> cData
            cData := AllTrim((cAlias)->CR_DATALIB)
            cHora := ""
        EndIf
    EndIf
    (cAlias)->(DbCloseArea())
Return {Left(cNome, 60), cData, cHora}

/** Quando concluiu: a última entrada (SD1) do pedido; sem entrada (resíduo), agora. */
Static Function Conclusao(cFilPed, cNum)
    Local cAlias := Consulta("SELECT MAX(D1_DTDIGIT) AS DATA FROM " + RetSqlName("SD1") + ;
        " WHERE D1_FILIAL = " + Q(xFilial("SD1", PadR(cFilPed, Len(cFilAnt)))) + " AND D1_PEDIDO = " + Q(cNum) + " AND D_E_L_E_T_ = ' '")
    Local cData  := DToS(Date())
    Local cHora  := Time()

    If !(cAlias)->(Eof()) .And. !Empty((cAlias)->DATA) .And. AllTrim((cAlias)->DATA) <> cData
        cData := AllTrim((cAlias)->DATA)
        cHora := ""
    EndIf
    (cAlias)->(DbCloseArea())
Return {cData, cHora}

// ---------------------------------------------------------------------------------------------------------------
// Utilitários
// ---------------------------------------------------------------------------------------------------------------
Static Function AliasCab()
Return AllTrim(SuperGetMV("MV_XOEEPCC", .F., "ZP1"))

Static Function AliasIte()
Return AllTrim(SuperGetMV("MV_XOEEPCI", .F., "ZP2"))

Static Function TabCab()
Return RetSqlName(AliasCab())

Static Function TabIte()
Return RetSqlName(AliasIte())

/** Nome do campo do cabeçalho (ZP1_xxx) e do item (ZP2_xxx). */
Static Function C(cCampo)
Return AliasCab() + "_" + cCampo

Static Function I(cCampo)
Return AliasIte() + "_" + cCampo

Static Function OndeCab(cId)
Return " WHERE " + C("IDPORT") + " = " + Q(cId) + " AND D_E_L_E_T_ = ' '"

Static Function OndeIte(cId)
Return " WHERE " + I("IDPORT") + " = " + Q(cId) + " AND D_E_L_E_T_ = ' '"

/** "ZP1_DTxxx = 'AAAAMMDD', ZP1_HRxxx = 'HH:MM:SS'" com a data e a hora de agora. */
Static Function Agora(cQuando)
Return C("DT" + cQuando) + " = " + Q(DToS(Date())) + ", " + C("HR" + cQuando) + " = " + Q(Time())

/** Grava o valor só se o campo ainda estiver em branco. */
Static Function SeVazio(cCampo, cValor)
Return cCampo + " = CASE WHEN " + cCampo + " = ' ' THEN " + Q(IIf(Empty(cValor), " ", cValor)) + " ELSE " + cCampo + " END"

/** "AAAAMMDD HH:MM:SS" de nMinutos atrás (para comparar com DTATU + ' ' + HRATU). */
Static Function Limite(nMinutos)
    Local dData := Date()
    Local nSeg  := Seconds() - (nMinutos * 60)

    If nSeg < 0
        nSeg  += 86400
        dData := dData - 1
    EndIf
Return DToS(dData) + " " + StrZero(Int(nSeg / 3600), 2) + ":" + StrZero(Int(Mod(nSeg, 3600) / 60), 2) + ":" + StrZero(Int(Mod(nSeg, 60)), 2)

/** Marca do C7_OBS que liga o pedido do Protheus ao nº do portal. */
Static Function Marca(cId)
Return "OEE#" + cValToChar(Val(cId)) + " "

Static Function StatusMuro(cId)
    Local cAlias  := Consulta("SELECT " + C("STATUS") + " AS STATUS FROM " + TabCab() + OndeCab(cId))
    Local cStatus := ""

    If !(cAlias)->(Eof())
        cStatus := AllTrim((cAlias)->STATUS)
    EndIf
    (cAlias)->(DbCloseArea())
Return cStatus

/** Abre uma consulta e devolve o alias. */
Static Function Consulta(cSql)
    Local cAlias := GetNextAlias()

    DbUseArea(.T., "TOPCONN", TcGenQry(, , cSql), cAlias, .F., .T.)
Return cAlias

/** UPDATE na muro, com o erro no console. */
Static Function Exec(cSql)
    If TcSqlExec(cSql) < 0
        OeeLog("erro de SQL: " + TcSqlError() + " | " + cSql)
        Return .F.
    EndIf
Return .T.

/** Texto entre aspas para o SQL (aspas simples dobradas). */
Static Function Q(cTexto)
Return "'" + StrTran(AllTrim(cTexto), "'", "''") + "'"

/** Número com ponto decimal para o SQL. */
Static Function Num(nValor)
Return AllTrim(Str(nValor, 18, 4))

Static Function OeeLog(cTexto)
    FWLogMsg("INFO", , "OEEPCJOB", "OEEPCJOB", , , "[OEEPCJOB] " + cTexto)
Return
